# imgbed 配置示例：复制为 config.yaml 后按需修改。
# 所有密钥都可以用环境变量覆盖（见 internal/config/config.go 的 applyEnv）。

server:
  addr: ":18080"
  # 浏览器直连本服务的来源白名单（CORS）。留空 = 全放行。
  allowed_origins:
    - "https://img.taojun.top"

ucenter:
  base_url: "https://ucenter.june-t.top"
  # 必须与 Ucenter Worker 的 APPS 环境变量里的标识一致，用于校验 JWT 的 aud。
  app: "imgbed"
  jwks_ttl: "1h"

r2:
  # 建议全部用环境变量注入，不要写在这里。
  account_id: ""
  access_key_id: ""
  secret_access_key: ""
  bucket: "image"
  prefix: ""                     # 留空 = bucket 根目录
  public_base: "https://img.june-t.top"
  private_prefix: "private/"     # 私有对象放这里，不绑定自定义域名
  # 查真实占用用的 Cloudflare API Token（需 R2 读权限）。留空则存储条回退到数据库口径。
  cf_api_token: ""
  # 存储配额（字节），进度条的分母。默认 10 GiB = R2 免费档。
  quota_bytes: 10737418240

db:
  # OCI HeatWave（MySQL 兼容）。两种给法二选一：
  #   1) 直接给 dsn
  #   2) 留空 dsn，用下面的分字段拼装（推荐，密码走环境变量 IMGBED_DB_PASSWORD）
  dsn: ""
  # 数据库地址：填你的 MySQL 主机名或 IP（私网地址、托管实例的内网域名均可）
  host: "db.example.internal"
  port: 3306
  name: "imgbed"
  user: "junet"
  password: ""
  # TLS 模式，取值与 go-sql-driver 对齐：
  #   preferred    有机会就用 TLS 但不校验证书（默认，等价 mysql 客户端的 PREFERRED）
  #   true         用系统根证书严格校验（HeatWave 内部域名是自签证书，配这个必然失败）
  #   skip-verify  用 TLS 但不校验证书
  #   false        完全不用 TLS
  tls_mode: "preferred"
  max_open_conns: 16
  max_idle_conns: 8
  # 托管 MySQL 与中间的负载均衡常在数分钟后掐掉空闲连接，设小一点避免拿到死连接
  conn_max_lifetime_sec: 180

limits:
  max_upload_mb: 20
  max_batch: 50
  folder_migrate_warn: 5000      # 超过此数量迁移前需二次确认
  trash_retain_days: 7           # 回收站保留天数，到期物理删除
